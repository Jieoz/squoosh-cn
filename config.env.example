# squoosh-cn 部署配置示例
#
# 用法：
#   cp config.env.example config.env
#   # 按下面注释填写自己的值
#   ./build.sh          # 只需要 SQ_SITE_ORIGIN / SQ_BASE_PATH
#   ./deploy.sh         # 还需要 SSH 相关项
#
# config.env 已被 .gitignore 忽略，不会进仓库。

# ---- 构建期必填 ----

# 站点源（协议 + 域名，不带尾斜杠）。写入 og:image / canonical。
SQ_SITE_ORIGIN=https://example.com

# 部署到站点下的哪个路径。部署到域名根目录就填 /
SQ_BASE_PATH=/squoosh-cn/

# dist.orig 里的产物是按哪个前缀编译的。
# 用本仓库 README 的方式从一个已部署的 /squoosh-cn/ 站点抓基线时保持默认即可；
# 若你自己编译 Squoosh 时用了别的 PATH_PREFIX，改成那个值。
SQ_SOURCE_BASE_PATH=/squoosh-cn/

# ---- 部署期（只有用 deploy.sh 时才需要）----

# SSH 目标主机，形如 user@host
SQ_SSH_HOST=user@example.com

# SSH 私钥路径
SQ_SSH_KEY=~/.ssh/id_ed25519

# 服务器上的站点根目录（build 会被放到 $SQ_REMOTE_ROOT/<basename of SQ_BASE_PATH>）
SQ_REMOTE_ROOT=/var/www/html

# 部署后 chown 给谁（留空则不改所有者）。形如 uid:gid 或 user:group
SQ_REMOTE_OWNER=
